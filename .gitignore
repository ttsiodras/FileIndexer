indexer.toml

# Runtime artifacts (never commit these - they contain your file index)
files.db
files.db-wal
files.db-shm
report.log

# Python build / cache artifacts
__pycache__/
.mypy_cache/
.pytest_cache/
.coverage
.coveragerc

# Local tool config and setup markers
.setup
.analysed

# Virtual environment
.venv/
